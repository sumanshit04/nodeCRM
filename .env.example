PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/crm_system?schema=public"

SESSION_SECRET=change-this-to-a-long-random-string
SESSION_COOKIE_NAME=crm.sid

# Same-origin by default. Set to your frontend origin if hosted separately.
CORS_ORIGIN=http://localhost:3000

# Cookie flags. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
